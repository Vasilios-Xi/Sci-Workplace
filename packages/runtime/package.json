{
  "name": "@openlab/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./child": "./dist/child.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/child.ts",
    "test:deepseek": "tsx src/deepseek/smoke.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@openlab/kernel": "workspace:*",
    "@openlab/plugin-sdk": "workspace:*",
    "@openlab/protocol": "workspace:*",
    "adm-zip": "^0.6.0",
    "ajv": "^8.17.1",
    "diff": "^8.0.4",
    "hono": "^4.12.9",
    "node-pty": "^1.1.0",
    "pnpm": "11.19.0",
    "typescript": "^5.9.3",
    "ws": "^8.18.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/diff": "^7.0.2",
    "@types/ws": "^8.18.1"
  }
}
